{
  "name": "fastify-secrets-hashicorp",
  "version": "3.1.2",
  "description": "Fastify secrets plugin for HashiCorp Vault",
  "main": "lib/fastify-secrets-hashicorp.js",
  "types": "types/index.d.ts",
  "files": [
    "lib/",
    "types/index.d.ts",
    "example/"
  ],
  "scripts": {
    "lint": "eslint lib test && prettier --check README.md types tsconfig.json",
    "lint:fix": "eslint lib test --fix && prettier --write README.md types tsconfig.json",
    "lint:staged": "lint-staged",
    "test": "c8 --100 node --test && tstyche"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/fastify-secrets-hashicorp.git"
  },
  "author": "Alasdair McLeay <alasdair.mcleay@nearform.com>",
  "license": "Apache-2.0",
  "keywords": [
    "fastify",
    "secrets",
    "hashicorp",
    "vault",
    "sensitive",
    "encryption"
  ],
  "bugs": {
    "url": "https://github.com/nearform/fastify-secrets-hashicorp/issues"
  },
  "homepage": "https://github.com/nearform/fastify-secrets-hashicorp#readme",
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "fastify": "^5.2.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "proxyquire": "^2.1.3",
    "tstyche": "^5.0.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,ts}": "prettier --write"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint:staged"
    }
  },
  "dependencies": {
    "fastify-secrets-core": "^4.0.0",
    "fastify-plugin": "^5.1.0",
    "node-vault": "^0.12.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  }
}
